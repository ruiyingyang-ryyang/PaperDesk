{
  "name": "paperdesk",
  "productName": "PaperDesk",
  "version": "1.0.1",
  "description": "Bilingual research workbench with DeepSeek, GPT and academic writing",
  "main": "src/main.cjs",
  "author": "PaperDesk contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node scripts/verify-desktop.cjs",
    "build:assets": "node scripts/build-assets.cjs && node scripts/build-vendor.cjs",
    "package:win": "node scripts/package.cjs win32",
    "package:linux": "node scripts/package.cjs linux",
    "build:win": "npm run build:assets && npm run package:win && node scripts/build-installer.cjs",
    "build:win:builder": "npm run package:win && electron-builder --win nsis --x64 --prepackaged dist/PaperDesk-win32-x64 --publish never",
    "test:writing": "node scripts/verify-writing.cjs",
    "test:writing-options": "node scripts/verify-writing-options.cjs",
    "test:writing-modes": "node scripts/verify-writing-modes.cjs",
    "test:writing-state": "node scripts/verify-writing-state.cjs",
    "test:weekly-date": "node scripts/verify-weekly-date.cjs",
    "test:chat-search": "node scripts/verify-chat-search.cjs",
    "test:release": "node scripts/verify-release.cjs",
    "build:portable": "node scripts/build-portable.cjs",
    "test:v101": "electron scripts/verify-v101-inprocess.cjs",
    "test:v101:playwright": "node scripts/verify-v101.cjs",
    "test:layout": "node scripts/verify-layout.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "dompurify": "3.4.17",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "jsdom": "27.2.0",
    "katex": "0.19.1",
    "marked": "18.1.3",
    "playwright": "1.58.2",
    "sharp": "0.35.5"
  },
  "overrides": {
    "glob@>=9 <=14.0.1": "14.0.4",
    "minimatch@>=7 <11.0.1": "11.0.7"
  }
}
